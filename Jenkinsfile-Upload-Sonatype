#!/usr/bin/env groovy

pipeline {

    agent any

    tools {
        jdk 'jdk21'
        maven 'maven'
    }



    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }



    stages {

        stage('Upload') {
            steps {
                // juel is intentionally excluded from the Maven reactor (see #188 —
                // Quarkus workspace VerifyError). It must be installed into .m2
                // before the main build for each new SNAPSHOT version.
                sh "mvn -f juel/pom.xml install -DskipTests"
                sh "mvn clean install -DskipTests"
                sh "mvn clean deploy  -X -Pcentral-sonatype-publish -DskipTests"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}